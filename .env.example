# Jira Server / Data Center
# Prefer `python run.py` (prompts for credentials) or the browser Sign in page.
# Leave username/password blank here unless you want env-based auth.
JIRA_BASE_URL=https://jira.silabs.com
JIRA_USERNAME=
JIRA_PASSWORD=

# Project that holds Test Executions
JIRA_PROJECT_KEY=SW_SQA_TE

# Optional: project that holds Test cases (for repository browsing)
JIRA_TEST_PROJECT_KEY=SW_SQA_TC

# Xray issue type names on this Jira instance
JIRA_ISSUE_TYPE_TEST_EXECUTION=Xray Test Execution
JIRA_ISSUE_TYPE_TEST_PLAN=Xray Test Plan
JIRA_ISSUE_TYPE_TEST=Xray Test
# Failure triage similar-bug search (read-only).
# Primary (preferred) Coex SQA pool + optional extra pools (semicolon-separated).
JIRA_SIMILAR_BUG_BASE_JQL=project = "24367" AND issuetype = Bug AND reporter in (currentUser(), asthakur, lomayalu, membersOf(DL.Hyd-Coex-SQA))
JIRA_SIMILAR_BUG_EXTRA_JQL=project = SI91X AND issuetype in ("Bug", "Defect")
JIRA_SIMILAR_BUG_CORPUS_LIMIT=500
JIRA_SIMILAR_BUG_EXTRA_CORPUS_LIMIT=300
# Legacy fallback when JIRA_SIMILAR_BUG_BASE_JQL is blank
JIRA_BUG_PROJECT_KEYS=WIFI_BT_UTFHELP,SI91X
JIRA_BUG_ISSUE_TYPES=Bug,Defect
# Test *issue* fields (SWSQAT: Xray View Test Screen) — NOT Test Run TRCFs
XRAY_TECHNOLOGY_FIELD=customfield_22640
XRAY_TEST_SRC_MAP_ID_FIELD=customfield_32360
XRAY_TEST_REPO_PATH_FIELD=customfield_30962
XRAY_FEATURE_NAME_FIELD=customfield_32357
XRAY_SUB_FEATURE_NAME_FIELD=customfield_32346
XRAY_STACK_NAME_FIELD=customfield_32353
# Optional — leave blank to auto-detect by field name "release_name"
XRAY_RELEASE_NAME_FIELD=
XRAY_TECH_AREA_FIELD=customfield_33453
XRAY_TESTRAIL_SECTION_FIELD=customfield_33577
XRAY_CASE_ID_FIELD=customfield_33571
# Test issue "References" (e.g. RSCDEV epic URL)
XRAY_REFERENCES_FIELD=customfield_33347
XRAY_TEST_AREA_FIELD=customfield_33578
XRAY_TEST_ENVIRONMENTS_FIELD=
XRAY_TEST_PLAN_FIELD=

# Test *Run* custom fields (per execution) — numeric IDs from
# POST/GET /rest/raven/1.0/customFields/testRunValues?customFieldId=
# Confirmed: Host Platform=22, Interface type=20, Test Mode=19, Test_Execution_Method=18
XRAY_TRCF_FEATURE_NAME=
XRAY_TRCF_SUB_FEATURE_NAME=
XRAY_TRCF_JENKINS_URL=
XRAY_TRCF_EVK_VERSION=
XRAY_TRCF_HOST_PLATFORM=22
XRAY_TRCF_BUILD_VERSION=
XRAY_TRCF_INTERFACE_TYPE=20
XRAY_TRCF_TEST_MODE=19
XRAY_TRCF_TEST_EXECUTION_METHOD=18
XRAY_TRCF_BOARD_DETAILS=
XRAY_TRCF_MEASURED_KPI=
XRAY_TRCF_TARGET_KPI=

# Set true if your Jira uses a self-signed certificate
JIRA_VERIFY_SSL=true

# Optional defaults (leave blank so UI starts empty — user picks filters/plan/run)
DEFAULT_TECHNOLOGY=
DEFAULT_STACK_NAME=
DEFAULT_RELEASE_NAME=
DEFAULT_PLAN_KEY=

# Footer name shown site-wide
SITE_CREDIT_NAME=Teja Sree Jammulamadaka

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
